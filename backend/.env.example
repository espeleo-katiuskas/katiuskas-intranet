HTTP_ADDR=:8080
DATABASE_URL=postgres://intranet:intranet@localhost:5433/intranet?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-string

# Where the frontend is served — used to build the link in sign-in emails.
PUBLIC_BASE_URL=http://localhost:8000

# Leave SMTP_HOST empty to log sign-in emails instead of sending them
# (fine for local development: the link shows up in the API's logs).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
