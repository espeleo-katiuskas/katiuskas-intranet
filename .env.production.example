# Copy this file to .env (already gitignored — never commit the real one)
# and fill in real values before running:
#   docker compose -f docker-compose.production.yml up -d

# --- Dominio ----------------------------------------------------------------
# El contenedor web no gestiona TLS ni dominios — escucha en
# 127.0.0.1:64710 en texto plano (igual que en desarrollo) para que el
# reverse proxy que ya tengas en la máquina (con su propio Caddy u otro)
# le reenvíe el tráfico. DOMAIN solo se usa para construir la URL pública
# (https://...) que llevan los enlaces mágicos de acceso, así que debe ser
# el dominio real con el que la gente accederá, aunque este contenedor no
# lo sirva directamente.
DOMAIN=intranet.tudominio.org

# --- Base de datos ------------------------------------------------------
# Cualquier cadena larga y aleatoria; solo se usa internamente entre los
# contenedores api y postgres, nunca queda expuesta fuera de la máquina.
POSTGRES_PASSWORD=cambia-esto-por-un-valor-largo-y-aleatorio

# --- Primera cuenta de administración ------------------------------------
# Se usa una sola vez con:
#   docker compose -f docker-compose.production.yml --profile tools run --rm seed-admin
# No dejes los valores por defecto de cmd/seed-admin (admin@club.test /
# 600000000): son de sobra conocidos y esta es la cuenta que puede asignar
# el resto de roles. Pon aquí un email y teléfono reales que solo tú
# controles.
SEED_ADMIN_EMAIL=tu-email-real@tudominio.org
SEED_ADMIN_PHONE=600111222

# --- Correo saliente (opcional) ------------------------------------------
# Deja las cuatro variables vacías/comentadas para no enviar correo real:
# los enlaces mágicos de acceso solo se registran en
#   docker compose -f docker-compose.production.yml logs api
# Suficiente para una prueba inicial con poca gente — revisa los logs cada
# vez que alguien inicie sesión. Rellena esto cuando quieras enviar correos
# de verdad.
#SMTP_HOST=smtp.tudominio.org
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_FROM=intranet@tudominio.org

# --- Avisos y bot de Telegram (opcional) ----------------------------------
# Deja las dos variables vacías/comentadas para no usar Telegram en
# absoluto: los errores del API (fallos inesperados, no cualquier 4xx)
# solo se registran en los logs, igual que hasta ahora, sin aviso de
# logins ni de llamadas al API, y el bot no reacciona a nadie que le
# escriba. Rellénalas para activarlo todo: TELEGRAM_BOT_TOKEN es el token
# que te da @BotFather al crear el bot; TELEGRAM_LOG_CHAT_ID es el
# chat_id del grupo o canal donde quieres los avisos (un número negativo
# para un grupo, "@nombre" para uno público). Configurado, pasan cuatro
# cosas: errores inesperados del API, un aviso de cada inicio de sesión,
# un aviso de cada llamada al API que sea POST/PUT/PATCH/DELETE (método y
# ruta, no el contenido — puede ser bastante tráfico si el club usa la
# intranet activamente), y el bot pide su contacto a cualquiera que le
# escriba sin estar ya
# vinculado, vinculando su cuenta si el teléfono coincide con un socio y
# avisando al canal del resultado en cualquier caso.
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_LOG_CHAT_ID=
