# Updates testing and production from the repository, once: each one only if what
# it should be running has changed. It is started by katiuskas-intranet-deploy.timer every
# 15 minutes and by katiuskas-intranet-deploy.path whenever the webhook receiver asks for a
# deployment after a push, so everything it prints is in this unit's journal
# (journalctl -u katiuskas-intranet-deploy). See docs/environments.md ("Pull-based
# deployment") for how to install it.
#
# It runs as the owner of the installations, not as root; the only privileged thing
# it does, restarting the APIs' units, goes through sudo (the sudoers rule is in
# docs/environments.md), which is why NoNewPrivileges is not set.
[Unit]
Description=Katiuskas intranet: update testing and production from the repository
After=network-online.target postgresql.service
Wants=network-online.target
# Requests can come one after another (the path unit starts it again while a request
# is waiting): do not let systemd's default limit of 5 starts in 10 seconds stop that.
StartLimitIntervalSec=0
# A failed run is told by Telegram (katiuskas-intranet-notify-failure@.service).
OnFailure=katiuskas-intranet-notify-failure@%n.service

[Service]
Type=oneshot
User=katiuskas
Group=katiuskas
# The request is taken before the run starts, so that one that arrives while it runs
# puts it back and the path unit starts the unit again right after this run. A request
# that arrives during this unit's run is therefore never lost, and several of them are
# one rerun. (`-`: a missing file is not an error.)
ExecStartPre=-/bin/rm -f /var/lib/katiuskas-intranet-deploy/queue/pending
# A root-owned script (installed from scripts/deploy.sh), so that what the timer and the
# webhook make run is not something the unprivileged user (or the code it builds) can
# change. The settings are in /opt/katiuskas-intranet-deploy/deploy.env (see
# deploy/systemd/deploy.env.example).
ExecStart=/opt/katiuskas-intranet-deploy/deploy.sh --config /opt/katiuskas-intranet-deploy/deploy.env
# After a successful run the next failure is told at once (notify-failure.sh tells a unit that
# keeps failing only once in a while). Runs only when the one above succeeded.
ExecStartPost=-/bin/rm -f /var/lib/katiuskas-intranet-deploy/notified/%n
# Building from scratch and migrating can take a while on a small machine.
TimeoutStartSec=30min
Nice=10
PrivateTmp=true
