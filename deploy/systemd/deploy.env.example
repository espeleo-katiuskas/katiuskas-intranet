# /opt/katiuskas-intranet-deploy/deploy.env — settings of scripts/deploy.sh, read with its
# --config option. The shell sources it, so it and its directory must be owned by root
# and not writable by group or others (the katiuskas user only needs to read it);
# deploy.sh refuses it otherwise. It holds no secrets (those are in each environment's
# api.env). What each setting means is at the top of scripts/deploy.sh.
REPO_URL=https://github.com/<owner>/<repository>.git
STATE_DIR=/var/lib/katiuskas-intranet-deploy

# Testing follows the tip of `main`.
TESTING_INSTALL_DIR=/opt/katiuskas-intranet-testing
TESTING_SERVICE=katiuskas-intranet-testing.service

# Production follows the highest MAJOR.MINOR.PATCH tag of the repository.
PRODUCTION_INSTALL_DIR=/opt/katiuskas-intranet-stable
PRODUCTION_SERVICE=katiuskas-intranet-stable.service

# After production is updated, replace testing's data with a copy of production's
# (docs/environments.md, "Testing's data is a copy of production's"). The hook is
# a small executable of the administrator's, see deploy/systemd/after-production.sh.example.
AFTER_DEPLOY=/opt/katiuskas-intranet-deploy/after-production.sh

# systemd runs the unit with a minimal PATH: make sure git and the Go toolchain are on it.
PATH=/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin
