# /opt/katiuskas-intranet-deploy/backup.env — settings of scripts/backup.sh, read by
# katiuskas-intranet-backup.service as a systemd EnvironmentFile (so, no shell syntax and no
# quotes). It holds no secrets. What each one means is at the top of scripts/backup.sh.

# Where the backups are kept: a directory only the intranet user can read, since they hold
# people's documents. Better on another disk than the data.
BACKUP_DIR=/var/backups/katiuskas-intranet

# The newest 14 backups are kept, and of the older ones, the newest of each of the last 8 weeks.
KEEP_DAILY=14
KEEP_WEEKLY=8

# An executable that is called with the finished backup's directory, to copy it off this host
# (docs/environments.md, "Backups"). If it fails the run fails, but the backup is kept.
#AFTER_BACKUP=/opt/katiuskas-intranet-deploy/after-backup.sh
