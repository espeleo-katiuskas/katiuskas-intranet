# /opt/katiuskas-intranet-deploy/thumbnails.env — what katiuskas-intranet-thumbnails.service needs: the
# directory of the people's own files, the same as USER_FILES_ROOT in production's api.env. A systemd
# EnvironmentFile (no shell syntax, no quotes). It holds no secrets, on purpose: the service gets
# nothing else from production's configuration.
USER_FILES_ROOT=/srv/katiuskas-intranet/user-files
