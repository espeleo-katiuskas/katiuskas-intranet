# Updates testing and production from the repository, once: each one only if what
# it should be running has changed. Started by katiuskas-deploy.timer every 15
# minutes; the webhook receiver runs the same command whenever GitHub reports a
# push. See docs/environments.md ("Pull-based deployment") for how to install it.
#
# It runs as the owner of the installations, not as root; the only privileged thing
# it does, restarting the APIs' units, goes through sudo (the sudoers rule is in
# docs/environments.md), which is why NoNewPrivileges is not set.
[Unit]
Description=Katiuskas intranet: update testing and production from the repository
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=katiuskas
Group=katiuskas
# A root-owned script (installed from scripts/kick-deploy.sh), so that what the timer
# runs is not something the unprivileged user (or the code it builds) can change. A run
# that overlaps with one started by the webhook waits for it instead of running at the
# same time (the script queues requests). The settings are in
# /opt/katiuskas-deploy/deploy.env (see deploy/systemd/deploy.env.example).
ExecStart=/opt/katiuskas-deploy/kick-deploy.sh
# Building from scratch and migrating can take a while on a small machine.
TimeoutStartSec=30min
Nice=10
PrivateTmp=true
