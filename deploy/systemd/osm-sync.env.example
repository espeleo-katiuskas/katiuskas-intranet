# /opt/katiuskas-intranet-deploy/osm-sync.env — what katiuskas-intranet-osm-sync.service needs: the
# connection to production's database (the same DATABASE_URL as production's api.env) and where the
# downloaded extracts are kept. A systemd EnvironmentFile (no shell syntax, no quotes). It holds the
# database password, so it is readable by root and `intranet` only (mode 0640, group intranet).
DATABASE_URL=postgres://intranet:CHANGE-ME@127.0.0.1:5432/intranet?sslmode=disable
# The same directory as StateDirectory in the unit.
OSM_CACHE_DIR=/var/lib/katiuskas-intranet-osm
# Only if osmium is not in the path of the service.
#OSMIUM_BIN=/usr/bin/osmium
