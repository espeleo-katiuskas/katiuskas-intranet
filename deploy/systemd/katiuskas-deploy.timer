# Looks for something new to deploy every minute. When there is nothing new, a run
# is a single `git ls-remote`.
[Unit]
Description=Katiuskas intranet: look for updates of testing and production

[Timer]
OnBootSec=2min
OnUnitInactiveSec=1min
AccuracySec=10s
RandomizedDelaySec=10s

[Install]
WantedBy=timers.target
