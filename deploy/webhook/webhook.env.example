# /etc/katiuskas-intranet-webhook/webhook.env — the secret of the GitHub webhook, read by the
# receiver's unit. Owned by root, readable only by the receiver's user:
#   sudo install -m 0640 -g katiuskas-intranet-webhook webhook.env.example \
#     /etc/katiuskas-intranet-webhook/webhook.env
# and then edit it. Make a long random secret (for example `openssl rand -hex 32`) and put the
# same one in the webhook's settings in GitHub. A hex secret needs no quoting.
KATIUSKAS_INTRANET_WEBHOOK_SECRET=replace-me-with-a-long-random-hex-string
