[
  {
    "id": "katiuskas-intranet-deploy",
    "execute-command": "/usr/bin/touch",
    "command-working-directory": "/",
    "pass-arguments-to-command": [
      { "source": "string", "name": "/var/lib/katiuskas-intranet-deploy/queue/pending" }
    ],
    "trigger-rule-mismatch-http-response-code": 403,
    "trigger-rule": {
      "and": [
        {
          "match": {
            "type": "payload-hmac-sha256",
            "secret": "{{ getenv "KATIUSKAS_INTRANET_WEBHOOK_SECRET" | js }}",
            "parameter": { "source": "header", "name": "X-Hub-Signature-256" }
          }
        },
        {
          "or": [
            {
              "match": {
                "type": "value",
                "value": "ping",
                "parameter": { "source": "header", "name": "X-GitHub-Event" }
              }
            },
            {
              "and": [
                {
                  "match": {
                    "type": "value",
                    "value": "push",
                    "parameter": { "source": "header", "name": "X-GitHub-Event" }
                  }
                },
                {
                  "match": {
                    "type": "regex",
                    "regex": "^refs/(heads/main|tags/.+)$",
                    "parameter": { "source": "payload", "name": "ref" }
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
]
