# The webhook receiver that asks for a deployment when GitHub reports a push: pushhook
# (https://github.com/cespedes/pushhook) running with pushhook.conf.example's settings. It
# only listens on the local port; the site's reverse proxy sends
# /hooks/katiuskas-intranet-deploy to it over TLS. See docs/environments.md ("Pull-based
# deployment") for how to install it.
#
# It runs as a user of its own that owns nothing of the installations and needs no
# privileges: its command only creates the file
# /var/lib/katiuskas-intranet-deploy/queue/pending (the directory is group-writable for this
# user), which makes katiuskas-intranet-deploy.path start the deployment. What it logs (one
# line per request, with the reason when it rejects one) is in this unit's journal.
[Unit]
Description=Katiuskas intranet: webhook receiver (asks for a deployment on a push)
After=network.target

[Service]
User=katiuskas-intranet-webhook
Group=katiuskas-intranet-webhook
ExecStart=/usr/local/bin/pushhook -config /etc/katiuskas-intranet-webhook/pushhook.conf
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/katiuskas-intranet-deploy/queue

[Install]
WantedBy=multi-user.target
